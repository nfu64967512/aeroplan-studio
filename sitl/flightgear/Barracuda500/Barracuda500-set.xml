<?xml version="1.0"?>
<!--
  只當顯示器用的 FG 機體。FDM 是 external:
  物理全部來自我們的 ArduPilot + JSBSim,FG 只畫。
  => 這裡不需要任何氣動、系統、Nasal。
-->
<PropertyList>
  <sim>
    <description>Barracuda500 (external FDM, aeroplan-studio)</description>
    <author>aeroplan-studio</author>
    <flight-model>external</flight-model>
    <aero>Barracuda500</aero>
    <model>
      <path>Aircraft/Barracuda500/Models/Barracuda500.xml</path>
    </model>
    <view n="0">
      <internal type="bool">false</internal>
      <config>
        <x-offset-m type="double">0.0</x-offset-m>
        <y-offset-m type="double">1.0</y-offset-m>
        <z-offset-m type="double">0.0</z-offset-m>
      </config>
    </view>
    <chase-distance-m type="double">-25.0</chase-distance-m>
    <sound><audible type="bool">false</audible></sound>
  </sim>
</PropertyList>
