 "label": "analysis",
 "log_to_trial_mapping": {
  "BEAMIDP1": 18,
  "HV4SITL15": 13,
  "HV4SITL16": 14,
  "HV4W00": 17,
  "HV4W05": 16,
  "HV4W55": 15,
  "HV4W55S": "never armed, no dataflash log written (LASTLOG still 18)",
  "how_established": "each sitl/vtol/i10x/logs/000000NN.BIN mtime equals the matching runs/artifacts/<trial>/A1/flight.csv mtime to the 100 ns tick; independently consistent with the runbook's LASTLOG = 14 before this set and with the .t0/.t1 wall-clock epochs in runs/artifacts/PAPERPLAN1/sorties/logs/"
 },
 "nothing_was_run": "no SITL, no ArduPlane.exe, no MAVProxy, no planner, no git, no pip, no COM port. Read-only over the existing products.",
 "pipeline": [
  "ana_extract.py   18 dataflash .BIN (6 trials x 3 aircraft) -> cache/*.npz",
  "ana_uav.py       per-aircraft clock, altitude, distance, three wind lines",
  "ana_sep.py       pairwise separation, exact in continuous time, 3 geodesy frames",
  "ana_time.py      planned vs flown timing, distance, coverage (shapely)",
  "ana_alt.py       altitude compliance for D2, exported vs flown",
  "ana_verify.py    V1 Vincenty cross-check, V2 reproduce the reporter, V3 area scale",
  "ana_tables.py    -> out/tables.md, out/derived.json",
  "ana_contradictions.py -> out/contradictions.json"
 ],
 "what": "the paper's result tables, recomputed from the raw run products by this label's own code; nothing is inherited from hv_sitl_report.py, binalt.py, binsep.py, sortie_results.json or prep_result.json"
}