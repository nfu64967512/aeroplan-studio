  <!-- ── 偏航力矩 ────────────────────────────────────────────────── -->
  <axis name="YAW">
   <function name="aero/coefficient/Cnb">
    <description>方向靜穩定度 —— 正值代表風標穩定</description>
    <product>
     <property>aero/qbar-psf</property><property>metrics/Sw-sqft</property>
     <property>metrics/bw-ft</property><property>aero/beta-rad</property>
     <value>0.065</value>
    </product>
   </function>
   <function name="aero/coefficient/Cnr">
    <!-- ⚠️ 2026-08-27 試過調到 -0.15(增加偏航阻尼)。同批實測更糟,
         已回復 -0.10。見 Clda 的註解。 -->
