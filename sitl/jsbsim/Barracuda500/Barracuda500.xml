  <!-- ── 滾轉力矩 ⚠️ 導數全部是估算值,見檔頭 ───────────────────── -->
  <axis name="ROLL">
   <function name="aero/coefficient/Clb">
    <!-- ⚠️ 2026-08-27 試過調到 -0.04(理由:-0.08 是高翼加上反角教練機的
         量級,本機是中/低翼噴射 UAV)。**受控實測更糟**,已回復 -0.08。
         見 Clda 的註解。 -->
    <product>
     <property>aero/qbar-psf</property><property>metrics/Sw-sqft</property>
     <property>metrics/bw-ft</property><property>aero/beta-rad</property>
     <value>-0.08</value>
    </product>
   </function>
   <function name="aero/coefficient/Clp">
    <product>
     <property>aero/qbar-psf</property><property>metrics/Sw-sqft</property>
     <property>metrics/bw-ft</property><property>aero/bi2vel</property>
     <property>velocities/p-aero-rad_sec</property>
     <value>-0.42</value>
    </product>
   </function>
   <function name="aero/coefficient/Clr">
    <product>
     <property>aero/qbar-psf</property><property>metrics/Sw-sqft</property>
     <property>metrics/bw-ft</property><property>aero/bi2vel</property>
     <property>velocities/r-aero-rad_sec</property>
     <value>0.08</value>
    </product>
   </function>
   <function name="aero/coefficient/Clda">
    <!-- ⚠️⚠️ 2026-08-27 實測紀錄:**試過調小,被推翻,不要重試。**

         假說:pb/2V 過大。Clda=0.18、|Clp|=0.42、δa_max=0.35 rad、b=1.88 m、
         V=60 m/s ⇒ p_ss = 9.57 rad/s = 548 度/秒,pb/2V = **0.15**,
         是戰鬥機典型值 0.09 的 1.7 倍 ⇒ 看起來明顯過強。

         受控實測(只有這一個值不同,其餘完全相同):
           Clda 0.18  ⇒ 起飛、爬升 **688.9 m**,之後橫向失控
           Clda 0.06  ⇒ **連離地都做不到**(爬升 3.5 m),21 秒觸地
           Clda 0.12 + Clb -0.04 + Cnr -0.15 ⇒ 也飛不起來(爬升 4.0 m)

         ⇒ 降低副翼權限**讓情況更糟**,因為自駕儀失去救回擾動的能力。
            真正的失效不是權限過大,而是離地後的橫向極限環
            (p 峰值正負 190 到 220 度/秒、週期約 2 到 3 秒)。

         ⚠️ 這一組橫向導數與**整個慣量張量**都是估計值(見檔頭)。
            正確的下一步是**開迴路量測**:飛 FBWA、階躍副翼、量實得滾轉率,
            再據以校 Clda —— 不是照理論值猜。在量到之前不要再動這個數字。 -->
    <product>
     <property>aero/qbar-psf</property><property>metrics/Sw-sqft</property>
     <property>metrics/bw-ft</property><property>fcs/left-aileron-pos-rad</property>
     <value>0.18</value>
    </product>
   </function>
  </axis>

  <!-- ── 俯仰力矩 ────────────────────────────────────────────────── -->
