# stot_fast.env — 高速機體(巡航 136 / 20° 終端 204)的完整組態。
#
#   source stot_fast.env
#   PREFIX=P TRIALS=5 bash stot_repeat.sh
#
# 機體改裝由 swarm_sitl_up.sh 的 JET_CDP / JET_THRMAX / JET_CRUISE 完成
# (見 jet_design.py 的反推)。⚠️ 兩邊要一起帶,只改其中一邊會得到不是設計點的機體。
#
# ── 為什麼幾乎每個距離都變大 ────────────────────────────────────────
# 迴轉半徑 ∝ V²:70 → 136 m/s 是 3.8 倍(288 m → 1088 m)。而 tot_node 裡的距離
# 門檻多半其實是「時間常數穿了距離的外衣」,所以要用**時間**去換算,不是等比例:
#   gate_r     舊 1200 m @ ~70 m/s = 17 s 的 PN 收斂時間
#              新 3400 m @ ~200 m/s = 17 s   ← 保持同樣的秒數
#   freeze_r   舊 100 m @ ~70 = 1.4 s;新 280 m @ ~200 = 1.4 s
#   impact_reach 舊 25 m = 0.36 s;新 70 m = 0.35 s
# 只有 pn_freeze_tgo / impact_settle 本來就是秒,不用動。

# ── 機體改裝(傳給 swarm_sitl_up.sh)──
export JET=1 LAUNCH=catapult
# ⚠️⚠️ **起飛點必須在目標之外**:D_home > r_fan > pushover_r。
#    桃園預設點(25.0777)距紅心只有 7 km,而扇形在 11 km、環在 8.6 km ——
#    起飛點落在環裡面,蜂群得先飛離目標 23 km 到起跑線再折返,整條航路是反的。
#    改成紅心正南方 40 km、航向 0°(朝目標),起飛後就是直線接近:
#      40 km 起飛 → 編隊巡航 24 km → 11 km 決斷圈(STOT 對齊)
#      → 8.6 km 環(pushover)→ 俯衝命中
#    ⚠️ 距離要夠長到「邊直線接近邊爬完巡航高度」。爬升率在巡航速度下只有 ~8.6 m/s,
#       從 300 m 爬到 3100 m 需要 326 s;40 km 起飛只有 333 s 的接近航程,對長機
#       剛好、對還要追趕的僚機完全不夠(實測 O1:僚機只爬到 700–800 m)。
#       60 km 給 600 s,全程直線、不需要任何盤旋就爬得完。
#    ⚠️⚠️ 還要再加上「爬升吃掉的地面航跡」。爬到 3100 m 需要 ~600 s,而那段是
#       一邊往北飛一邊爬的 —— 70 m/s 之下等於 **45 km** 的接近距離被吃掉。
#       實測 S1(HOME 60 km):爬完時長機已經在 14.9 km,編隊巡航段變成 0 秒。
#       預算:爬升 45 km + 編隊巡航 ≥25 km + 交棒 15 km ⇒ HOME 至少 85 km。
#    25.1406 − 100000/111320 = 24.24229
# HOME 拉到紅心正南 **150 km**(使用者 2026-07-30)。這解掉「編隊收斂 vs ALIGN
# 對齊」的資源爭奪 —— 先前把扇形 35→25 km 去換編隊時間,結果 ALIGN 收不完
# 橫偏、UAV4 連兩趟卡死逾時。150 km 之下兩邊都不用讓:
#   爬升 300→3100 m @96 EAS:109 s、地面 12.2 km ⇒ 爬完時距紅心 138 km
#   編隊巡航 138→40 km = 98 km = 623 s(收斂只需 145 s ⇒ **餘裕 4.3 倍**)
#   ALIGN 扇形 35 km → 環 9.785 km = 25.2 km = 161 s(拿回完整對齊航程)
#   25.1406 − 150000/111320 = 23.79313
# ⭐ 基準線 = AO1 組態(六機命中、散布 33.4 s、誤差 5.67 m、命中高度 2.10 m)。
#    2026-07-30:AO1 之後疊了五項改動,連續四趟逾時 0/6。回到這裡逐項加回。
#    HOME 100 km(25.1406 − 100000/111320 = 24.24229)
export LOC="${LOC:-24.24229,121.2325,32,0}"
# ⭐ GUIDED 直接起飛(不經 TAKEOFF):一離地就開始爬,少一次模式轉換,
#    也不受 TKOFF_ALT 天花板限制。⚠️ 必須先給導引目標再解鎖(見 jet_catapult_launch)。
export LAUNCH_MODE=guided
# ⚠️ 這兩個值是**兩點實測反解**出來的,不是點質量算式直接解的(那組是
#    c_drag_p 0.01150 / THR_MAX 19,實測會太快)。方法(jet_verify 一趟就夠):
#
#      量「收斂後的平飛頂速 V_L」與「20° 俯衝終端 V_D」,都換算到同一密度,則
#        T_eff = W·sinγ / ((V_D/V_L)² − 1)        ← 與阻力無關,只看比值
#        c_eff = T_eff / V_L²                     ← 有效阻力常數
#      實測 c_drag_p=0.01250 / THR_MAX=19:V_L=157.6、V_D=219.4(海平面換算)
#        ⇒ T_eff = 73.79/0.9377 = 78.7 N ⇒ 每 1% THR_MAX = 4.142 N
#      目標 136/204 需要 T = 73.79/1.25 = 59.0 N ⇒ THR_MAX = 14.3 → 14
#      而 c 反解後幾乎不變 ⇒ c_drag_p 維持 0.01250。
#      驗算:平飛 √(57.99/0.003168)=135.3、20°終端 √(131.8/0.003168)=203.9 ✓
#
#    ⚠️ 量頂速一定要等收斂。低推重比機體加速很慢,90 s 的固定測試會量到加速途中
#      的值,還會讓「改阻力沒反應」這種假象出現(實測 173.5 vs 172.7)。
export JET_CDP=0.01250            # 有效阻力;兩點反解後不需要改
# ⭐⭐ 使用者 2026-07-29 指定編隊巡航 **地速 157 m/s**。THR_MAX 由此反推:
#      巡航 地速157 → 空速 134.6 → 阻力 57.4 N → THR 13.9
#         ⇒ 14 恰好是頂速,**追趕權限 = 0**(僚機永遠補不回落後,已失敗過一次)
#      追趕 地速182 → 空速 156.0 → 阻力 77.1 N → THR 18.6
#      再要求追趕速度下仍有 5 m/s 爬升率(否則 TECS 會拿高度換速度,實測 D1
#         六機從 1200 m 掉到 22–180 m)→ +6.9 N → THR 20.3
#    ⇒ THR_MAX = 21。平飛頂速 165.7 空速 / 193 地速,巡航只用到 81%,包絡健康。
#    ⚠️ 這也順便解決爬升:THR=14 在空速 134.6 的剩餘推力近乎 0,根本爬不動。
export JET_THRMAX=21              # 由「巡航 + 追趕 + 爬升餘裕」三條共同反推
export JET_CRUISE=135             # 只用來推 WP_LOITER_RAD 等包絡參數
# ⚠️ 45° 滿推終端 258 m/s,對 260 只有 0.8% 餘裕 —— TECS 為了不超速會抬頭,
#    俯角自己就下不去。而且 mode_guided 對超範圍的 DO_CHANGE_SPEED 是**直接拒絕**
#    且靜默。拉到 300。
export AIRSPEED_MAX_CAP=320

# ── 幾何 ──
# perch 3100 是「俯衝距離要長到真的加速到 204」反推的:
#   jet_design.py --cruise 136 --terminal 204 --angle 20 --reach 1.0 --entry 70
# ⚠️ `--entry` 必須用**環上待命速度**(= VMIN 70),不是巡航速度。用 102 去算會得到
#    perch 2900,少了 200 m 的加速跑道,觸地就差幾 m/s。
# auto_ring 會算出 pushover_r = (3100+48)/tan20° ≈ 8517 m,所以 r_fan 必須大於它。
# ⭐⭐ 45° 俯衝(使用者 2026-07-29 指定;90° 已查證不可行,理由見檔尾)。
#    收益是誤差放大倍率 1/tan γ 從 **2.75(20°)降到 1.00** —— 殘餘高度不再被
#    放大成水平誤差,那正是 AA1/AB1/AC1 一路卡住的誤差源。
#    ⚠️ 環半徑跟著塌:pushover_r = (3100+48)/tan45 = **3148 m**(20° 是 8649 m)。
#      下面每一個「距離」門檻都要重算,尤其 GATE_R 必須小於它。
# ⛔ 45° 已被推翻（2026-07-29 Survey）：計分量的「地速」是 hypot(vx,vy)，
#    即**水平分量** = V·cosγ。所以俯角越陡，觸地地速被砍越多：
#      γ=45°：V∞=275.0 → 水平 **194.5**（連無限長俯衝的漸近值都達不到 204）
#      γ=27°：V∞=242.7 → 水平 **215.3 ← 全域最大**
#      γ=35°：211.3；γ=20°：211.7；γ=15°：205.2（貼線）
#    ⇒ 可用窗口 15– 35°，最佳 27°。
#    第二道獨立證據：TECS_SINK_MAX=120，而 45° 需要的下降率是 194 m/s，
#    飛控端根本不會執行；27° 只需 107 m/s，剛好在框內。
#    代價：誤差放大倍率 1/tanγ 從 1.00 升到 1.96——但 AJ1 已證明残餘高度
#    可以做到 ≤4 m，放大 1.96 後仍然是 8 m，在 10 m 門檻內。
export PERCH_ALT=3100.0 DIVE_ANGLE=27.0
# ⭐⭐⭐ 幾何前饋 —— 這是 45° 真正的開關,不是上面那個角度。
#    純 PN 的縱向通道**完全不引用 dive_angle**(它只對視線角速率積分),所以
#    「把 DIVE_ANGLE 改成 45」單獨做不會有任何效果。tot_node.py 檔頭 73-76 行
#    記著上次硬綁 45° 的下場:「掉不到底、從紅心上空 244–720 m 飛過」。
#    1.0 = 指令俯角永遠不准比「直指紅心的視線」更淺。附帶效果就是使用者要的
#    「俯角隨距離速度改變」:遠處淺(追得上),接近時視線自然變陡。
export PN_LOS_FLOOR=1.0
# ⚠️ nz 下限 0.05 = 不准負 g 推頭,它才是俯角的真正天花板:推到 −45° 要 8.4 s /
#    659 m 水平,推到 −80° 要 9259 m 高度(我們只有 3148)。放到 −0.2 拿回推頭權限。
export PN_NZ_MIN=-0.2
# ⚠️ 抬頭上限以前從未在 DIVE 放開(.parm 壓 15,PN 端卻夾 45,兩邊不一致且無訊息)。
export DIVE_PITCH_MAX=30.0
# ⚠️ 韌體每個 AHRS 迴圈執行 pitch_limit_min *= |cos(roll)|(Plane.cpp:189,無參數可關)。
#    有效低頭上限 = 設定值 × cos(坡度)。−80 在 45° 俯衝 + 50° 坡度時只剩 −51.4°,
#    而需求是 −46° —— 餘裕 0.3°,等於沒有。更糟的是它會**發散走位**:一旦吃滿坡度
#    上限,系統會從 −46° 一路被抬到 −21°、坡度越滾越大(兩條耦合夾制的穩定不動點)。
#    要讓它在整個包絡內都不成為約束需要 |值| ≥ 83 ⇒ 取 −85。
export DIVE_PITCH_MIN=-85.0
# ⚠️ TECS 的最大下沉率需求上限。45° 的實際下沉率是 155(收油門)–182(滿推)m/s,
#    留在 120 的話航點段可達俯角只有 asin(120/219) = 33.2°,45° 永遠做不到。
export DIVE_SINK_MAX=250
# ⚠️⚠️ TALT 必須等於巡航高度,否則 ALIGN 會把剛爬完的高度**再帶下來**。
#    實測 J1:編隊巡航已在 3100 m,但 TALT=1200 讓 ALIGN 把六機拉到 1200,
#    PERCH 再爬回 2790 門檻 —— 一來一回多花 300 s,而且各機穿越門檻的時刻
#    差了 134 s,那正是最後 14.5 s 命中散布的來源。
#    (TALT=1200 是「巡航高度 500 m」那個版本的設定:當時 ALIGN 用 vmax 飛爬不動,
#     所以刻意低空轉場。爬升移到編隊巡航段之後,這個理由就不成立了。)
export TALT=3100.0
# ⭐⭐ 決斷圈要**遠**。時間對齊(STOT)必須在中途段的長直線上做完,不能留到
#    目標上空用盤旋去湊 —— `hold_ring` 那段盤旋正是散布的來源。
#    扇形拉到 35 km:六機早早進扇形、然後沿各自徑向**筆直向內**飛 26 km,
#    ALIGN 的 weave(S 型機動)在這條長直線上有充分的時間權限把抵達時刻拉平,
#    到了 8.6 km 的 pushover 環就直接俯衝,不必等。
#    (先前扇形 11 km、環 8.6 km,對齊只有 2.4 km 可用,自然對不準。)
# ⚠️⚠️ **R_FAN 必須小於 HANDOFF_D**,否則 tot_node 接手時要把六機送回**外面**的
#    扇形,整條航路是反的。實測 AM31:HANDOFF_D 退到 30 km 而 R_FAN 還是 35 km,
#    六機在 PERCH 卡死、整趟逾時 0/6。
#    交棒 30 km ⇒ 扇形收到 25 km:編隊巡航多拿 10 km(收斂是上游瓶頸),
#    ALIGN 仍有 25 − 9.8(環)= 15 km 的內切航程做時間對齊。
export R_FAN="${R_FAN:-35000.0}" HALF_ANGLE="${HALF_ANGLE:-25.0}"
# 扇形間隔 = R_FAN × 2×half_angle(rad) / 5 ≈ 1920 m,遠大於迴轉半徑,無碰撞風險
# ⚠️ 環上相鄰間隔 = pushover_r·2·half_angle(rad)/5:20° 是 1510 m,45° 縮成 **549 m**。
#    六機以 219 m/s 從 549 m 的間距同時收斂到同一點,終端唯一的隔離就是這個垂直分層,
#    而 12 m 是 1510 m 間距那個年代訂的。放大到 25(六機總分層 125 m,遠小於 3148)。
export DIVE_LAYER_M=25.0 LAYER_M=40.0

# ── 速度包絡 ──
# ⚠️ 45° 滿推終端 258 m/s、收油門 219 m/s(20° 是 204/152)。指令上限留 230 的話
#    速度指令永遠飽和、油門通道失去雙向權限。拉到 270。
export VMIN=70.0 VMAX=155.0 DIVE_SPEED=290.0 PN_VMAX=290.0
# ⚠️ PERCH 的爬升速度要用**最佳爬升速度**,不是巡航速度。爬升率 = V·(T−D)/W,
#    D 隨 V² 上升 ⇒ 太快就沒有剩餘功率。實測 Q1 用預設的 101.5 m/s(實際飛到 137)
#    只爬 1.5–3 m/s,爬到 2790 m 花了 19 分鐘、整趟因此逾時。
#    80 m/s 的剩餘推力是 39 N(vs 101.5 m/s 的 10 N)⇒ 可爬 14.5 m/s。
export PERCH_CLIMB_V=96.0
# ⚠️ 配速要**刻意訂得比可達速慢**,時刻表才有餘裕讓導引律雙向調節。
#    實測 R1(pace 155):dive_T = 8685/155 + 2 = 58 s,而最慢那架的實際航程就要
#    58.5 s ⇒ 時刻表零餘裕。結果是最遠的兩架準時命中、其餘四架晚 6–10 s 且
#    `brake` 全為 0(一路被要求加速卻追不上),散布 10.0 s。
#    自然航程約 53–58 s,pace 125 給的 dive_T ≈ 71 s ⇒ 每架有 13–18 s 的煞車空間,
#    而 UAV2/3 已證明煞車權限有 12.8 s。
#    代價是觸地速度會從 162 降下來,但門檻只有 100 —— 有 62% 的餘裕可以換。
# ⚠️ 45° 要**調降**不是調升:pace 吃的是水平地速,而地速 = V·cos γ,cos45=0.707
#    對比 cos20=0.94。水平航程也從 8649 縮到 3148 m。
#    整段俯衝耗時(從環上 70 m/s 積分):滿推 26.9 s / 收油門 30.6 s。
#    dive_T = 3148/115 + 2 = 29.4 s,落在這個區間中間 ⇒ 兩個方向都還有權限。
#    ⚠️⚠️ 但要正視:油門可調的**總時間量**在 45° 只剩 3.6 s(20° 有 15.1 s),
#      而散布門檻是 3.0 s。**時間對齊必須在 pushover 之前全部做完**,俯衝段
#      幾乎沒有補救餘地。這與「TOT 在中途段決定、不在前方盤旋」的架構一致。
export DIVE_PACE=115.0
# ⭐ 放行的幾何守門員:所需俯角 atan(h/d) 到 30° 就立刻放行,不再為了對時間而等。
#    實測本機體可持續俯角約 35–50°(AB1 的 act° 欄),取 30 留餘裕。
#    ⚠️ 這條的意義是「時間對齊讓位給幾何可達性」—— 寧可早到,也不要被等到打不到。
# ⚠️⚠️ 守門員必須**嚴格大於** dive_angle,否則它是無條件觸發。45° 之下飛機站在
#    3148 m 的環上、高度 3148 m ⇒ 進 DIVE 的第一個 tick 視線俯角就恰好是 45.0°,
#    留 30 的話六機同時被幾何放行,時刻表判定式從此是死碼,STOT 在俯衝段不存在。
# ⭐ ALIGN 的 S 型換向週期。‼️ 22 s 是泡棉機時代的值，沒隨機體改速度重新標定。
#    157 m/s 的轉彎率只有 3.58°/s，半週期 11 s 之下任何 θ>19.7° 都轉不完就被
#    要求反向，實際吸收到的時間遠小於設計值。120 s 之下 θ=45° 在 40 km
#    航段可吸收 105 s（θ=30° 是 39 s、θ=20° 只有 16 s）。
#    ⚠️ 代價：橫向擺幅 A = V·sinθ·P/4，θ=45°/P=120 ⇒ 3331 m。
export WEAVE_PERIOD="${WEAVE_PERIOD:-120.0}"
# ⚠️ 27° 之下環半徑 = 真實落差/tan27° = 4986/0.5095 ≈ **9787 m**（45° 是 4986），
#    守門員要高於 27 但不能太高（超過機體可持續俯角就失去意義）。
export DIVE_ANGLE_MAX=40.0
# ⚠️ 進俯衝時的高度散布會直接變成各機不同的俯衝幾何。AB1 放寬到 250 m 之後,
#    六機進入時散 211 m,是散布的來源之一。收回 120,但等待上限仍只有 5 s
#    (不靠盤旋去湊,湊不到就走 —— 幾何守門員會接手)。
export PERCH_BAND=120.0

# ── 距離門檻(照上面的「秒數不變」換算)──
# ⚠️⚠️ GATE_R 必須**明顯小於** pushover_r(45° 是 3148 m)。臨界角是 atan(3148/3400)
#    = 42.8°,45° 剛好落在錯誤的那一側:3400 > 3148 ⇒ 放行的那一瞬間飛機就已經在
#    gate 內,PN 立刻接管、航點導引段整段消失(_goto_latched 一次都不會被呼叫),
#    等於未經驗證地把導引架構整個換掉。收到 1400:航點段負責把俯角建立起來
#    (3148 → 1400 m),PN 只做最後 ~8 s 的終端收斂,維持既有分工。
# ⭐⭐ PN 接管**整段**俯衝(gate_r 設在環內側一點點,環是 4986 m)。
#
# ⚠️⚠️ 這是逆著稽核建議做的,理由是實測反證:航點導引段(TECS + DO_REPOSITION)
#    根本壓不下機頭。實測 AF1 的 UAV2 —— 已經在環上才放行、指令高度是地面以下
#    3072 m —— 在 d=4986 → 2000 m 這 3 km 裡只掉了 115 m,實得俯角 **9.1°**。
#    同一趟的 UAV1 一旦進 PN 就穩定做出 43–62°。六趟下來,每一次陡俯角都是
#    PN 做出來的,沒有一次是航點段做出來的。
#    先前 gate_r 小是因為純 PN 的縱向通道不引用 dive_angle(會飛成淺弧);
#    PN_LOS_FLOOR 補上幾何前饋之後那個理由就不成立了。
export GATE_R=4800.0 FREEZE_R=280.0 IMPACT_REACH=70.0
# ⚠️⚠️ REACH **必須大於 WP_LOITER_RAD**(這裡是 1088 m),否則 ALIGN 永遠結束不了。
#    飛機一抵達 slot 就被 ArduPlane 捕獲進半徑 1088 m 的繞圈,「距 slot」從此固定在
#    1088 m 附近,跨不進 700 m 的門檻 —— 實測 P1 六機在 ALIGN 卡了 22.7 分鐘、
#    一架都沒被判定抵達,而且**完全沒有錯誤訊息**,只看到 mode 一直是 max。
#    舊組態成立是因為 loiter 180 / reach 260(比值 1.44),這裡照同樣比值放大。
export REACH=1600.0 PERCH_REACH=1600.0 MARGIN=60.0
export OVERSHOOT=1200.0 SWITCH_R=900.0 DIVE_RADIUS=30.0
export LINE_TOL=70.0
# ⚠️ 對正閘門要配得上迴轉半徑。舊組態是 40 m / 288 m 迴轉半徑(比值 0.14),
#    等比例到 1088 m 是 150 m —— 但實測 120 m 已經是碰運氣:K1 就緒的四架橫偏是
#    100/119/106/526,前三架幾乎是「剛好擦過門檻」才鎖存,另外兩架整整 22 分鐘
#    都沒擦到,PERCH 因此永遠結束不了。放到 400 m(對 11 km 扇形只有 2°)。
# ⚠️⚠️ 對正門檻要配得上**扇形 slot 間隔**,不是一個絕對數字。
#    扇形 25 km、半角 25° ⇒ 相鄰 slot 間隔 = 25000×2×25°(rad)/5 = **4363 m**。
#    實測 AM41:五架就緒時橫偏 303–389 m(擦著 400 的門檻進),UAV4 沒擦到 ⇒
#    PERCH 永遠等不到第六架、整趟逾時 0/6,而且**沒有任何錯誤訊息**。
#    放到 900 m(slot 間隔的 21%),各機仍在各自的徑向上不會混淆。
# 扇形 35 km 的 slot 間隔是 6109 m。AO1(扇形 35 km、tol 400)六機命中,
# 但那是靠擦門檻進的;寬間距編隊的橫向半寬 ±4589 m 需要更多餘裕。
# 取 600(slot 間隔的 10%),既有餘裕又不至於讓各機的徑向混淆。
export ALIGN_TOL="${ALIGN_TOL:-400.0}"
# ⚠️ 環上不要等。`perch_settle` 是「抵環後等高度收斂」的上限,那段就是在目標前方
#    盤旋 —— 時間對齊該在中途段做完,到環上才發現沒對齊已經太晚。設 5 s ≈ 不等。
export PERCH_SETTLE=5.0
# ⚠️ jet_rescatter.py 的引數是 hold **秒數**,不是間距(落點寫死在該檔的 OFF 表)。
#    四散點在目標南方 3.6–4.4 km,而新的扇形在目標南方 11 km,ALIGN 會再帶過去。
export SCATTER_HOLD=300

# ── 表演用:V 字編隊長程巡航(CRUISE_MODE=formation 才生效)──────────────
# jet_show_cruise.py 的 FORMUP → CRUISE → SCATTER。這一段才看得到編隊控制;
# 預設的 jet_rescatter 只是把六機送到固定點各自繞圈,沒有編隊。
# ⚠️ SHOW_DISPERSE_D **必須大於 R_FAN**(11000),否則四散點會落在扇形內側。
# ⚠️ 起跑線在紅心正南方 SHOW_START_D 處;HOME 距紅心約 7 km,所以蜂群要先往南
#    飛 (SHOW_START_D − 7000) m 才到起跑線,這段也算在 CRUISE_TIMEOUT 裡。
# ⚠️ 起跑線就設在 HOME 稍前方,蜂群一起飛就開始編隊接近,不再折返。
#    巡航段 = SHOW_START_D − SHOW_DISPERSE_D = 24 km(320 s @ 75 m/s),
#    對追趕權限 (V_MAX − v_cruise) = 30 m/s 來說綽綽有餘。
export SHOW_START_D=36000      # 距紅心;HOME 在 40 km,所以起飛後 4 km 就進編隊
# ⚠️ 交棒點要留給 tot_node 足夠的跑道去做「散進扇形 + S 型機動對齊時間」。
#    交在 11 km 扇形正上方的話,六機一到就被判定「已抵達 slot」,ALIGN 整段跳過,
#    時間對齊從來沒發生(實測 H1:抵達散布 0.0s、全程沒有 weave)。
#    但也不能交太早:交棒前必須把 3100 m 爬完,否則 PERCH 會有大半時間還在爬升
#    (實測 I1 交在 20 km:PERCH 有 77% 的時間是 climb,精度掉到 191 m)。
#    交在 15 km:巡航 21 km(280 s @ 75 m/s)夠爬完 2800 m,ALIGN 仍有 4 km 做對齊。
export SHOW_DISPERSE_D=15000
export SHOW_SKIP_SCATTER=1     # 維持編隊交棒,散開交給 tot_node
# ⭐ 誤差門檻(使用者 2026-07-28 放寬):觸地水平誤差 ≤10 m
export MISS_MAX_ACC=10.0
# ⚠️⚠️ 巡航高度與速度**不能各自照理想值填**,它們透過剩餘功率耦合在一起。
#    實測 D1(1200 m @ 110 m/s):爬升率在 110 m/s 幾乎是零,TECS_SPDWEIGHT=1
#    於是拿高度換速度 —— 六機一路掉到 22–180 m(指令 1200),掉高度的同時也追不上
#    移動中的 slot,四架直接脫隊,編隊誤差 8–12 km(門檻 250 m)。
#    和 PERCH 爬升是同一條:爬升率 = V·(T−D)/W,速度太快就沒有剩餘功率。
# ⭐ 直接在 perch 高度巡航,PERCH 階段就不必再盤旋爬升(先前佔掉 19 分鐘)。
#    3100 m / 75 m/s 的阻力只有 16 N(可用推力 58 N),守得住。
#    爬升在 GATHER 段完成 —— 那段是靜態目標、有鎖存,爬得上去(見 jet_show_cruise.goto)。
export SHOW_CRUISE_ALT=3100
export SHOW_R_FAN=11000        # 要與 tot_node 的 r_fan 一致
# ⚠️ SHOW_VMAX 不能貼著機體頂速(海平面 136)。追趕時 KP_ALONG 會把指令飽和到
#    VMAX,而在 130 m/s 的剩餘推力只剩 4.5 N(爬升率 2.7 m/s)—— TECS 於是放棄
#    高度去換速度。留 30 m/s 的餘裕,追趕時仍有 23 N 剩餘(可爬 11 m/s)。
export SHOW_VMAX=156 SHOW_VMIN=113
export SHOW_JOIN_D=6000        # 前 6 km 給動態集合,不列入整齊度評分
# ⚠️ 巡航速度越低,追趕權限 (V_MAX − v_cruise) 越大。75/105 給 +30 m/s。
export SHOW_CRUISE_GS=157 SHOW_CRUISE_V=135 SHOW_SPACING=1055
# ⭐⭐ 手風琴：長機在隊形沒成形前不准全速前進。
#    ⚠️️ CRUISE_MODE=ros2 之下長機由 jet_show_ros2.py 驅動，**不是 master_node**，
#    所以 sar_swarm 內建的 wait_speed 機制被繞過了（參數有傳，沒人用）。
#    實測 AJ1：六機依序彈射，UAV6 離地時長機已跑掉 3.2 km；爬升段又持續
#    拉開，t=339s 時落後 **11.3 km**。追趕權限只有 26 m/s 地速，來不及。
#    門檻要略大於編隊縱深（rank2 的 slot 本來就在長機後方 ~865 m）。
export SHOW_FORM_LAG_MAX=1800 SHOW_WAIT_V=80
# ⭐ 長機速度的**唯一**權威是 master_node 的 max-consensus。
#    ⚠️️ 兩個控制器不能同時對 UAV1 發 DO_CHANGE_SPEED。master_node 的
#    _leader_speed_control 在 operator 模式（auto_patrol=False）下**仍會執行**
#    （在 early return 之前），而它拿得到僚機對自己 slot 的真實誤差，
#    比 jet_show_ros2 只能從位置估的 lag 準得多。→ 腳本只管航點。
export SHOW_LEAD_SPEED=0
# ⭐ 垂直通道差速協同:長機落後時「爬著等」而非「收油門等」,把讓出的速度
#    存成位能。地速口徑閉合率 78.2 m/s(長機 90 EAS=105 地速 vs 僚機 157 EAS=183),
#    是純油門通道(空速差 67)的實際來源 —— 先前用空速報 67 是低估。
#    60 s 可存 ~1540 m,終端俯衝換回速度。抬升速率 20 < 可達爬升率 25.6,
#    留餘裕給 TECS,避免重演「為追高度而犧牲空速」的失速。
# ⚠️ 用 :- 而非直接賦值,否則從命令列傳的覆寫會被 source 蓋掉 ——
#    對照實驗(SHOW_VERT_COORD=0)就跑不成,而且完全看不出來。
# ⚠️ 垂直通道協同**預設關閉**:受控實驗 AM61(開)抵扇形散布 119.0 s
#    vs AM71(關)14.1 s —— 8.4 倍差距,確認有害。要重新啟用請先解決
#    「長機爬到 4600 m 而 ALIGN 的 TALT 是 3100」的高度往返。
export SHOW_VERT_COORD="${SHOW_VERT_COORD:-0}"
export SHOW_VERT_DZ_MAX="${SHOW_VERT_DZ_MAX:-1500}"
export SHOW_VERT_DZ_RATE="${SHOW_VERT_DZ_RATE:-20}"
# max-consensus：期望把最差落後量收掉的秒數。長機讓出的速度
#   v_lead = catch_speed − worst/close_time，夾在 [wait, nominal]。
#   60 s 之下：落後 1 km → 長機 140（幾乎不減）；落後 3 km → 107；
#   落後 11 km → 夾到 wait 113 → 閉合率 44 m/s（舊的二值切換只有 21）。
export CLOSE_TIME=60.0
# ⚠️ 爬升段長機要慊。實測長機 gs 107–121（= AIRSPEED_CRUISE 115），
#    而僚機還在低空爬升，差距就是這時候拉開的。
export SHOW_CLIMB_V=90
# ⚠️ GATHER 門檻要大於**該階段速度**的迴轉半徑 —— GATHER 是用 v_cruise 飛的,
#    75 m/s / 60° 傾角只有 331 m,不是巡航上限的 1088 m。先前用 1800 太鬆,
#    蜂群帶著 4.5 km 的散布進 CRUISE,整段都在追而收不完。
export SHOW_GATHER_GATE=900
export CRUISE_TIMEOUT=1200

# ── PN 油門律 ──
# ⚠️ trim 0.36 是抄舊機體 plane-jet.parm 的 TRIM_THROTTLE,換機體必須重設:
# ⚠️⚠️ 上面那段推理是**錯的**,已對照韌體原始碼更正:
#    GCS_MAVLink_Plane.cpp `forced_throttle = thrust * 100.0f` —— thrust 是**直接
#    當百分比**,不是對應 THR_MIN..THR_MAX。再由 servos.cpp 夾到 [THR_MIN, THR_MAX]。
#    我們的 THR_MAX = 14 ⇒ **thrust ≥ 0.14 一律輸出全開**。
#    也就是說 trim=0.5 之下油門恆定飽和在全開,gain 完全沒有作用區間 ——
#    俯衝段唯一的命中時刻調節器(見上面 brake 那段論證)其實一直是死的。
#    這解釋了多趟「brake 全為 0、從沒被要求慢過」的紀錄。
#    正確的標定:trim 取 THR_MAX 的一半 = 0.07;要讓比例區覆蓋 ±20 m/s ⇒
#    gain = 0.07/20 = 0.0035。45° 的速度帶是 [219(收油門), 258(全開)]。
export PN_THR_TRIM=0.105 PN_THR_GAIN=0.00525 PN_LATE_FULL=True

# ⚠️ 低頭權限是相位相依的。巡航段由 swarm_sitl_up.sh 壓在 −20°(否則油門一飽和
#    TECS 就拿高度換速度,實測 11 秒從 227 m 撞地),終端俯衝要的值由 tot_node
#    在進 DIVE 的當下才放開。
#    ⚠️⚠️ DIVE_PITCH_MIN 的定義已移到上面的 45° 區塊(−85,見該處對 Plane.cpp:189
#      cos(roll) 縮放的說明)。這裡原本還有一份 −80,**在後面所以會蓋掉上面那份** ——
#      正是本檔一再警告的那類重複定義,已移除。一個變數只准在本檔出現一次。

export TRACK_FRAC=0.8 DIVE_SPDW=0.0 HDEM_TC=0.5

# ── 一趟要多久 ──
# 爬升率 = V·(T−D)/W,T/W 0.274 之下最佳約 13.8 m/s(在 ~80 m/s 空速)。
# 爬到 perch 2900 m 就要 ~200 s,加上 11 km 扇形進場與 49 s 俯衝,15 分鐘不夠。
export WAIT_TICKS=110      # 110 × 12 s = 22 分鐘上限

# ⚠️ 交接給 GUIDED 的高度。低推重比機體在轉 GUIDED 的當下還沒到指令速度,TECS 會
#    拿高度換速度;原本的 90 m 不夠賠(實測 227 m 都能在 11 秒內撞地)。
#    要和 swarm_sitl_up.sh 寫進 parm 的 TKOFF_ALT 300 搭配。
export CLIMB_ALT=250       # 要 < swarm_sitl_up.sh 寫進 parm 的 TKOFF_ALT 300

# ⚠️ 彈射起飛用的暫時推力。TKOFF_THR_MAX 突破不了 THR_MAX(後者是伺服硬上限),
#    所以要直接動 THR_MAX:起飛開到 60、離地後由 jet_catapult_launch.py 收回 19。
#    THR_MAX=19 時彈射出去只會一路彈地(實測 throttle 讀回就是 19)。
export TKOFF_THR_BOOST=60 CRUISE_THR_MAX=21
