/* ======================================================================
 * AeroPlan Studio — Global MIL-STD-1472H Stylesheet
 * ----------------------------------------------------------------------
 * 全域軍規樣式（Global Military-Standard QSS）
 *
 * 本檔為 Mustache 風格模板；由 ui/resources/tactical_theme.py 的
 * apply_tactical_theme() 在啟動時以 TacticalColors / TacticalFonts
 * 常數替換佔位符（如 BG_PRIMARY, FG_PRIMARY 等）後注入 QApplication。
 *
 * 嚴格遵循之 MIL-STD-1472H 條款（章節編號標註於各節）：
 *   5.1.2.2.1  Functional grouping / Hierarchical labeling
 *   5.2.3      Displays — readability in ambient light
 *   5.7.3      Alerts, warnings, cautions
 *   5.17.10    Error messages — constructive & neutral tone
 *   5.17.14    Status indicators
 *   5.17.18.7  Typography — sans-serif mandatory; monospaced for numerics
 *   5.17.25    Color coding — semantic colors (no decorative use)
 *   5.17.25.16 Dark adaptation — dark background, light text
 *
 * 設計鐵則（不可違反）：
 *   (1) 全直角（border-radius: 0）— 任何 radius 被視為商用裝飾，不得出現。
 *   (2) 無漸層（flat）— linear-gradient 一律禁用，避免色階干擾暗視覺。
 *   (3) 極薄邊線（1px）— 降 GPU 負擔、降發光雜訊。
 *   (4) 色彩語意嚴守 — 紅=敵危失、黃=警、綠=正常，不得裝飾用。
 *   (5) hover/pressed 僅變更邊框色與前景色；絕不大面積改變底色塊。
 *   (6) 遙測數字強制等寬字型，避免數值跳動時視覺抖動。
 * ====================================================================== */


/* ======================================================================
 * §1  Global Base — 全域基底 (MIL-STD 5.17.25.16.4 Dark Adaptation)
 * ----------------------------------------------------------------------
 * 深藏青 (#0A0F14) 非純黑：保留視桿細胞暗適應 (scotopic vision)。
 * 淺灰文字 (#E0E1DD) 非純白：降低夜間眩光、避免瞳孔頻繁收縮。
 * ====================================================================== */
QMainWindow,
QDialog {
    background-color: {{BG_PRIMARY}};
    color: {{FG_PRIMARY}};
}

QWidget {
    background-color: transparent;
    color: {{FG_PRIMARY}};
    font-family: {{FONT_SANS}};  /* 5.17.18.7.2 Sans-serif mandatory */
    font-size: 9pt;
}

/* Tooltip — 琥珀色 (570-590 nm) 重點字，暗視覺可讀性最佳 */
QToolTip {
    background-color: {{BG_ELEVATED}};
    color: {{FG_EMPHASIS}};
    border: 1px solid {{BORDER_STRONG}};
    padding: 4px 8px;
    font-family: {{FONT_MONO}};
    font-size: 9pt;
}


/* ======================================================================
 * §2  MenuBar / ToolBar (MIL-STD 5.1.2.2.1 Hierarchical Labeling)
 * ====================================================================== */
QMenuBar {
    background-color: {{BG_SECONDARY}};
    color: {{FG_PRIMARY}};
    border-bottom: 1px solid {{BORDER_DEFAULT}};
    padding: 2px 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 1px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: {{BG_ELEVATED}};
    color: {{FG_EMPHASIS}};
    border-bottom: 2px solid {{NEUTRAL}};
}

QMenu {
    background-color: {{BG_ELEVATED}};
    color: {{FG_PRIMARY}};
    border: 1px solid {{BORDER_STRONG}};
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 20px;
}

QMenu::item:selected {
    background-color: {{BG_SECONDARY}};
    color: {{FG_EMPHASIS}};
}

QMenu::separator {
    height: 1px;
    background-color: {{BORDER_SUBTLE}};
    margin: 4px 8px;
}

QToolBar {
    background-color: {{BG_SECONDARY}};
    border: none;
    border-bottom: 1px solid {{BORDER_DEFAULT}};
    padding: 4px;
    spacing: 4px;
}

QToolBar::separator {
    background-color: {{BORDER_SUBTLE}};
    width: 1px;
    margin: 4px 6px;
}

QToolButton {
    background-color: transparent;
    color: {{FG_SECONDARY}};
    border: 1px solid transparent;
    padding: 6px 10px;
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 1px;
}

QToolButton:hover {
    background-color: {{BG_ELEVATED}};
    color: {{FG_EMPHASIS}};
    border: 1px solid {{BORDER_STRONG}};
}

QToolButton:pressed,
QToolButton:checked {
    background-color: {{BG_ELEVATED}};
    color: {{NEUTRAL}};
    border: 1px solid {{NEUTRAL}};
}

QToolButton:disabled {
    color: {{FG_MUTED}};
}


/* ======================================================================
 * §3  Push Buttons — 戰術指令鈕 (MIL-STD 5.17.25.8 Semantic Color)
 * ----------------------------------------------------------------------
 * 語意角色以 dynamic property "tacticalRole" 控制：
 *   "execute"  — 執行／確認／友軍（綠）
 *   "abort"    — 中止／緊急／敵方（紅）
 *   "caution"  — 需確認／警示（黃）
 *   "primary"  — 主要操作（琥珀強調）
 * 使用：btn.setProperty("tacticalRole", "abort"); btn.style().polish(btn)
 * ====================================================================== */
QPushButton {
    background-color: {{BG_SECONDARY}};
    color: {{FG_PRIMARY}};
    border: 1px solid {{BORDER_DEFAULT}};
    padding: 6px 14px;
    min-height: 24px;
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 1px;
}

QPushButton:hover {
    border: 1px solid {{NEUTRAL}};
    color: {{NEUTRAL}};
}

QPushButton:pressed {
    background-color: {{BG_ELEVATED}};
    border: 1px solid {{FG_EMPHASIS}};
    color: {{FG_EMPHASIS}};
}

QPushButton:disabled {
    color: {{FG_MUTED}};
    border: 1px solid {{BORDER_SUBTLE}};
}

QPushButton:focus {
    /* 鍵盤焦點可見性 — ISO 9241-171 / WCAG 2.4.7 */
    outline: none;
    border: 1px solid {{FG_EMPHASIS}};
}

/* ──── 語意色按鈕：執行／確認（綠）──── */
QPushButton[tacticalRole="execute"] {
    border: 1px solid {{FRIENDLY}};
    color: {{FRIENDLY}};
}
QPushButton[tacticalRole="execute"]:hover {
    background-color: rgba(0, 230, 118, 0.12);
}
QPushButton[tacticalRole="execute"]:pressed {
    background-color: rgba(0, 230, 118, 0.22);
}

/* ──── 中止／緊急（紅）——— 仿 MIL-STD 紅色 Guard 蓋按鈕風格 ──── */
QPushButton[tacticalRole="abort"] {
    border: 1px solid {{HOSTILE}};
    color: {{HOSTILE}};
}
QPushButton[tacticalRole="abort"]:hover {
    background-color: rgba(255, 0, 60, 0.14);
}
QPushButton[tacticalRole="abort"]:pressed {
    background-color: rgba(255, 0, 60, 0.28);
}

/* ──── 警告／需確認（黃）──── */
QPushButton[tacticalRole="caution"] {
    border: 1px solid {{WARNING}};
    color: {{WARNING}};
}
QPushButton[tacticalRole="caution"]:hover {
    background-color: rgba(255, 183, 3, 0.14);
}

/* ──── 主要操作（琥珀）──── */
QPushButton[tacticalRole="primary"] {
    border: 1px solid {{FG_EMPHASIS}};
    color: {{FG_EMPHASIS}};
}
QPushButton[tacticalRole="primary"]:hover {
    background-color: rgba(255, 183, 3, 0.10);
}


/* ======================================================================
 * §4  Input Controls — 輸入控制項 (MIL-STD 5.17.18.7 Monospaced Numerics)
 * ----------------------------------------------------------------------
 * 所有數值輸入強制等寬字型，避免快速輸入／跳動時左右抖動。
 * 輸入值以琥珀色呈現，符合 HUD 夜視傳統（低眩光、高可識別）。
 * ====================================================================== */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QPlainTextEdit,
QTextEdit {
    background-color: {{BG_SUNKEN}};
    color: {{FG_EMPHASIS}};
    border: 1px solid {{BORDER_DEFAULT}};
    padding: 4px 6px;
    selection-background-color: {{NEUTRAL}};
    selection-color: {{BG_PRIMARY}};
    font-family: {{FONT_MONO}};
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border: 1px solid {{NEUTRAL}};
}

QLineEdit:read-only,
QPlainTextEdit:read-only,
QTextEdit:read-only {
    background-color: {{BG_PRIMARY}};
    color: {{FG_SECONDARY}};
    border: 1px solid {{BORDER_SUBTLE}};
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: {{FG_MUTED}};
    border: 1px solid {{BORDER_SUBTLE}};
}

/* SpinBox 按鈕：無漸層、直角、hover 僅變邊框 */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: {{BG_SECONDARY}};
    border: 1px solid {{BORDER_SUBTLE}};
    width: 14px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    border: 1px solid {{NEUTRAL}};
}

QComboBox {
    background-color: {{BG_SUNKEN}};
    color: {{FG_PRIMARY}};
    border: 1px solid {{BORDER_DEFAULT}};
    padding: 4px 6px;
    font-family: {{FONT_MONO}};
    min-height: 22px;
}
QComboBox:hover,
QComboBox:focus {
    border: 1px solid {{NEUTRAL}};
}
QComboBox::drop-down {
    border: none;
    width: 18px;
    background-color: transparent;
}
QComboBox QAbstractItemView {
    background-color: {{BG_ELEVATED}};
    color: {{FG_PRIMARY}};
    border: 1px solid {{BORDER_STRONG}};
    selection-background-color: {{BG_SECONDARY}};
    selection-color: {{FG_EMPHASIS}};
    outline: 0;
}


/* ======================================================================
 * §5  Table / Tree / List — 表格與樹狀視圖 (MIL-STD 5.1.2.2.1 Labels)
 * ====================================================================== */
QTableWidget,
QTableView,
QTreeView,
QListView {
    background-color: {{BG_SECONDARY}};
    alternate-background-color: {{BG_ELEVATED}};
    color: {{FG_PRIMARY}};
    gridline-color: {{BORDER_SUBTLE}};
    border: 1px solid {{BORDER_DEFAULT}};
    selection-background-color: {{BG_ELEVATED}};
    selection-color: {{FG_EMPHASIS}};
    font-family: {{FONT_MONO}};  /* 數值欄位一律等寬 */
    outline: 0;
}

QHeaderView::section {
    background-color: {{BG_PRIMARY}};
    color: {{FG_SECONDARY}};
    border: none;
    border-right: 1px solid {{BORDER_SUBTLE}};
    border-bottom: 1px solid {{BORDER_DEFAULT}};
    padding: 6px 8px;
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 1px;
}

QHeaderView::section:hover {
    color: {{FG_EMPHASIS}};
}

QTableWidget::item:selected,
QTableView::item:selected,
QTreeView::item:selected,
QListView::item:selected {
    background-color: {{BG_ELEVATED}};
    color: {{FG_EMPHASIS}};
    border-left: 2px solid {{NEUTRAL}};
}


/* ======================================================================
 * §6  Progress Bar — 進度條 (MIL-STD 5.17.14 Status Indicators)
 * ----------------------------------------------------------------------
 * 語意 property "barStatus":  nominal | warning | critical
 *   nominal  — 綠色 (正常)
 *   warning  — 黃色 (接近閾值)
 *   critical — 紅色 (超過閾值，應觸發主告警)
 * ====================================================================== */
QProgressBar {
    background-color: {{BG_SUNKEN}};
    border: 1px solid {{BORDER_DEFAULT}};
    color: {{FG_PRIMARY}};
    text-align: center;
    font-family: {{FONT_MONO}};
    font-weight: bold;
    min-height: 14px;
    max-height: 18px;
}

QProgressBar::chunk {
    background-color: {{NEUTRAL}};
    margin: 0;
}

QProgressBar[barStatus="nominal"]::chunk  { background-color: {{FRIENDLY}}; }
QProgressBar[barStatus="warning"]::chunk  { background-color: {{WARNING}}; }
QProgressBar[barStatus="critical"]::chunk { background-color: {{HOSTILE}}; }


/* ======================================================================
 * §7  Tabs & GroupBox — 分頁與功能分組 (MIL-STD 5.1.2.2.1)
 * ----------------------------------------------------------------------
 * QGroupBox 即為「功能分組 (Functional Grouping)」單位：
 * 將相關控制項（飛行姿態、武裝、通訊）集中置於獨立 GroupBox 中，
 * 標題以琥珀色階層式標籤呈現。
 * ====================================================================== */
QTabWidget::pane {
    background-color: {{BG_SECONDARY}};
    border: 1px solid {{BORDER_DEFAULT}};
    top: -1px;
}

QTabBar::tab {
    background-color: {{BG_PRIMARY}};
    color: {{FG_SECONDARY}};
    border: 1px solid {{BORDER_SUBTLE}};
    padding: 6px 16px;
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 1px;
}

QTabBar::tab:selected {
    background-color: {{BG_SECONDARY}};
    color: {{FG_EMPHASIS}};
    border-top: 2px solid {{NEUTRAL}};
    border-bottom: 1px solid {{BG_SECONDARY}};
}

QTabBar::tab:hover:!selected {
    color: {{FG_PRIMARY}};
}

QGroupBox {
    background-color: transparent;
    border: 1px solid {{BORDER_DEFAULT}};
    margin-top: 14px;
    padding-top: 10px;
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 1px;
    color: {{FG_SECONDARY}};
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 8px;
    color: {{FG_EMPHASIS}};
    background-color: {{BG_PRIMARY}};
}


/* ======================================================================
 * §8  CheckBox / RadioButton
 * ====================================================================== */
QCheckBox,
QRadioButton {
    color: {{FG_PRIMARY}};
    spacing: 6px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: {{BG_SUNKEN}};
    border: 1px solid {{BORDER_DEFAULT}};
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border: 1px solid {{NEUTRAL}};
}

QCheckBox::indicator:checked {
    background-color: {{NEUTRAL}};
    border: 1px solid {{NEUTRAL}};
}

QRadioButton::indicator:checked {
    background-color: {{BG_SUNKEN}};
    border: 4px solid {{NEUTRAL}};
}


/* ======================================================================
 * §9  ScrollBar — 極簡直角
 * ====================================================================== */
QScrollBar:vertical {
    background-color: {{BG_PRIMARY}};
    width: 10px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: {{BORDER_DEFAULT}};
    min-height: 24px;
    border: none;
}
QScrollBar::handle:vertical:hover {
    background-color: {{BORDER_STRONG}};
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background-color: {{BG_PRIMARY}};
    height: 10px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: {{BORDER_DEFAULT}};
    min-width: 24px;
    border: none;
}
QScrollBar::handle:horizontal:hover {
    background-color: {{BORDER_STRONG}};
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
}


/* ======================================================================
 * §10  StatusBar / Splitter / DockWidget
 * ====================================================================== */
QStatusBar {
    background-color: {{BG_SECONDARY}};
    color: {{FG_SECONDARY}};
    border-top: 1px solid {{BORDER_DEFAULT}};
    font-family: {{FONT_MONO}};
}

QStatusBar::item {
    border: none;
}

/* 狀態列訊息語意色（MIL-STD 5.17.10.7 建設性語氣） */
QStatusBar QLabel[msgSeverity="info"]     { color: {{NEUTRAL}}; }
QStatusBar QLabel[msgSeverity="ok"]       { color: {{FRIENDLY}}; }
QStatusBar QLabel[msgSeverity="warning"]  { color: {{WARNING}}; }
QStatusBar QLabel[msgSeverity="critical"] { color: {{HOSTILE}}; }

QSplitter::handle {
    background-color: {{BORDER_SUBTLE}};
}
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

QDockWidget {
    color: {{FG_SECONDARY}};
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 1px;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: {{BG_SECONDARY}};
    border-bottom: 1px solid {{BORDER_DEFAULT}};
    padding: 4px 8px;
    text-align: left;
}


/* ======================================================================
 * §11  MasterWarningPanel — 主告警面板 (MIL-STD 5.7.3.8 Independent Panel)
 * ----------------------------------------------------------------------
 * 此面板必須獨立於一般狀態顯示區，永遠可見，不可被其他頁籤遮蔽。
 * 標題色調應隨最高嚴重度切換：
 *   無告警    — 邊框 BORDER_DEFAULT / 文字 FG_MUTED
 *   有 CAUTION — 邊框 WARNING / 文字 WARNING
 *   有 WARNING — 邊框 HOSTILE / 文字 HOSTILE（MIL-STD-411E 建議閃爍 2 Hz）
 * ====================================================================== */
MasterWarningPanel {
    background-color: {{BG_SECONDARY}};
    border: 1px solid {{BORDER_DEFAULT}};
}

MasterWarningPanel[severity="nominal"] {
    border: 1px solid {{BORDER_DEFAULT}};
}
MasterWarningPanel[severity="caution"] {
    border: 1px solid {{WARNING}};
}
MasterWarningPanel[severity="warning"] {
    border: 1px solid {{HOSTILE}};
}

MasterWarningPanel QLabel#MasterTitle {
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 2px;
    color: {{FG_MUTED}};
    padding: 4px 8px;
    background-color: {{BG_PRIMARY}};
    border-bottom: 1px solid {{BORDER_DEFAULT}};
}
MasterWarningPanel[severity="caution"] QLabel#MasterTitle {
    color: {{WARNING}};
    border-bottom: 1px solid {{WARNING}};
}
MasterWarningPanel[severity="warning"] QLabel#MasterTitle {
    color: {{HOSTILE}};
    border-bottom: 1px solid {{HOSTILE}};
}

/* 告警列表項（QListWidget 於 MasterWarningPanel 內） */
MasterWarningPanel QListWidget {
    background-color: {{BG_PRIMARY}};
    border: none;
    font-family: {{FONT_MONO}};
    font-size: 9pt;
    color: {{FG_PRIMARY}};
}
MasterWarningPanel QListWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid {{BORDER_SUBTLE}};
}
MasterWarningPanel QListWidget::item[alertLevel="caution"] {
    color: {{WARNING}};
}
MasterWarningPanel QListWidget::item[alertLevel="warning"] {
    color: {{HOSTILE}};
}
MasterWarningPanel QListWidget::item[alertLevel="advisory"] {
    color: {{NEUTRAL}};
}


/* ======================================================================
 * §12  Telemetry Readouts — 遙測讀值 (MIL-STD 5.17.18.7.2)
 * ----------------------------------------------------------------------
 * 所有即時跳動數字必須等寬字型，避免左右抖動。
 * 使用 dynamic property  role="telemetry-value"  來標示數值元件。
 * ====================================================================== */
QLabel[role="telemetry-label"] {
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 1px;
    color: {{FG_SECONDARY}};
    font-size: 8pt;
}
QLabel[role="telemetry-value"] {
    font-family: {{FONT_MONO}};
    font-weight: bold;
    color: {{FG_EMPHASIS}};
    font-size: 14pt;
}
QLabel[role="telemetry-value"][status="nominal"]  { color: {{FRIENDLY}}; }
QLabel[role="telemetry-value"][status="caution"]  { color: {{WARNING}}; }
QLabel[role="telemetry-value"][status="critical"] { color: {{HOSTILE}}; }
QLabel[role="telemetry-unit"] {
    font-family: {{FONT_MONO}};
    color: {{FG_MUTED}};
    font-size: 9pt;
}


/* ======================================================================
 * §13  Hierarchical Section Titles — 階層標籤 (MIL-STD 5.1.2.2.1)
 * ====================================================================== */
QLabel[role="section-title"] {
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 2px;
    color: {{FG_EMPHASIS}};
    font-size: 10pt;
    padding: 4px 0 4px 0;
    border-bottom: 1px solid {{BORDER_DEFAULT}};
}
QLabel[role="subsection-title"] {
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 1px;
    color: {{FG_SECONDARY}};
    font-size: 9pt;
    padding: 2px 0;
}


/* ======================================================================
 * §14  Navigation Rail — 左側功能導航
 * ----------------------------------------------------------------------
 * objectName="NavigationRail" 的 QWidget 套用；內含 QToolButton (checkable)。
 * ====================================================================== */
QWidget#NavigationRail {
    background-color: {{BG_SECONDARY}};
    border-right: 1px solid {{BORDER_DEFAULT}};
}

QWidget#NavigationRail QToolButton {
    background-color: transparent;
    color: {{FG_SECONDARY}};
    border: none;
    border-left: 3px solid transparent;
    padding: 12px 8px;
    text-align: left;
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 1px;
    min-height: 28px;
}
QWidget#NavigationRail QToolButton:hover {
    background-color: {{BG_ELEVATED}};
    color: {{FG_EMPHASIS}};
}
QWidget#NavigationRail QToolButton:checked {
    background-color: {{BG_ELEVATED}};
    color: {{FG_EMPHASIS}};
    border-left: 3px solid {{NEUTRAL}};
}


/* ======================================================================
 * §15  Top Status Strip — 頂部狀態列 (MIL-STD 5.17.14)
 * ----------------------------------------------------------------------
 * objectName="TopStatusStrip"
 * 顯示系統模式、GPS、LINK 品質、UTC 時間等全局指示器。
 * ====================================================================== */
QWidget#TopStatusStrip {
    background-color: {{BG_SECONDARY}};
    border-bottom: 1px solid {{BORDER_DEFAULT}};
    min-height: 32px;
    max-height: 32px;
}
QWidget#TopStatusStrip QLabel {
    font-family: {{FONT_CONDENSED}};
    font-weight: bold;
    letter-spacing: 1px;
    color: {{FG_SECONDARY}};
    padding: 0 10px;
}
QWidget#TopStatusStrip QLabel[indicator="value"] {
    font-family: {{FONT_MONO}};
    color: {{FG_EMPHASIS}};
}
QWidget#TopStatusStrip QFrame[role="separator"] {
    background-color: {{BORDER_SUBTLE}};
    max-width: 1px;
    min-width: 1px;
}


/* ======================================================================
 * §16  Dialog — 對話框 (MIL-STD 5.17.10.7.3 Constructive Error Messages)
 * ----------------------------------------------------------------------
 * 錯誤／警告對話框必須：
 *   (1) 建設性 — 提供明確的排除步驟，非僅指出錯誤
 *   (2) 中立語氣 — 不責備操作員，不使用「你做錯了」字眼
 *   (3) 明確指示 — 提供可採取的下一步動作
 * ====================================================================== */
QMessageBox {
    background-color: {{BG_ELEVATED}};
}
QMessageBox QLabel {
    color: {{FG_PRIMARY}};
    font-family: {{FONT_SANS}};
    min-width: 320px;
}
QMessageBox QLabel#qt_msgbox_label {
    font-size: 10pt;
    padding: 8px 0;
}
QMessageBox QLabel#qt_msgbox_informativelabel {
    color: {{FG_SECONDARY}};
    font-size: 9pt;
}


/* ======================================================================
 * §17  Existing Tactical Widgets — 相容既有自繪元件
 * ====================================================================== */
TacticalUAVCard {
    background-color: {{BG_SECONDARY}};
    border: 1px solid {{BORDER_DEFAULT}};
}
TacticalUAVCard:hover {
    border: 1px solid {{BORDER_STRONG}};
}
TacticalUAVCard[selected="true"] {
    border: 1px solid {{NEUTRAL}};
}
TacticalUAVCard[alarm="true"] {
    background-color: {{BG_SECONDARY}};
}


/* ======================================================================
 * §18  Slider — 拉桿 (HUD 風)
 * ====================================================================== */
QSlider::groove:horizontal {
    background-color: {{BG_SUNKEN}};
    border: 1px solid {{BORDER_SUBTLE}};
    height: 4px;
}
QSlider::handle:horizontal {
    background-color: {{FG_EMPHASIS}};
    border: 1px solid {{BG_PRIMARY}};
    width: 10px;
    height: 14px;
    margin: -6px 0;
}
QSlider::handle:horizontal:hover {
    background-color: {{NEUTRAL}};
}

QSlider::groove:vertical {
    background-color: {{BG_SUNKEN}};
    border: 1px solid {{BORDER_SUBTLE}};
    width: 4px;
}
QSlider::handle:vertical {
    background-color: {{FG_EMPHASIS}};
    border: 1px solid {{BG_PRIMARY}};
    height: 10px;
    width: 14px;
    margin: 0 -6px;
}


/* ======================================================================
 * §19  LCDNumber — 七段顯示器（如有使用）
 * ====================================================================== */
QLCDNumber {
    background-color: {{BG_SUNKEN}};
    color: {{FG_EMPHASIS}};
    border: 1px solid {{BORDER_DEFAULT}};
}

/* END  Global_MIL_STD.qss */
